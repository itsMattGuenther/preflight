// How Cloudflare runs Preflight: the app in dist/ (what `npm run build` writes)
// is served as static files, which cost nothing however many there are, and
// worker/index.js answers /api/* (one path per file in worker/functions/).
// Workers Builds runs `npm run build`, then `npx wrangler deploy` for main and
// `npx wrangler preview` for any other branch (the preview link it posts on the
// pull request). Response headers for the static files are in public/_headers.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "preflight",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-13",
  // Production is only at preflight.mattguenther.com.
  "routes": [{ "pattern": "preflight.mattguenther.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Airport pages are client-side routes (/KVBT): any path that isn't a file
    // gets index.html.
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // The shared cache (worker/lib/cache.js). Its table is in worker/migrations.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "preflight",
      "database_id": "f8b3db71-7d0a-4b51-9ba6-bd63ef853da1",
      "migrations_dir": "worker/migrations"
    }
  ],
  "observability": { "enabled": true },
  // Previews cache into their own database, so preview code never writes into
  // production's cache. API_AUTH_TOKEN is a secret, set for production and for
  // previews separately (see README).
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "preflight-preview",
        "database_id": "494fcd51-0e6d-45b7-ac08-be5487c22c7d",
        "migrations_dir": "worker/migrations"
      }
    ]
  }
}
